#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd -- "$(dirname "${BASH_SOURCE}")" ; cd .. > /dev/null 2>&1 && pwd -P)"
cd "${PROJECT_DIR}"

source "${PROJECT_DIR}/bin/env/select-tool-versions-manager"
source "${PROJECT_DIR}/bin/env/project.sh"
source "${PROJECT_DIR}/shared-clj/bin/helpers/build.sh"

function build_core {
  ./bin/cljs-release
  ./bin/clj-uberjar
}

build
cd -
echo "OK ✔"

# vi: ft=sh
